==
	-_attach_logs_to_visits()
	-_build_feedback_service()
	-_create_visits()
	-_on_filter_changed()
	-_on_new_data()
	-_on_new_validation_log()
	-_on_new_visits()
	-_on_updated_data()
}

class visits_model.VisitsModel #C58CBC {
	+FEEDBACK_READY, @ca
	+FILTER_APPLIED, @ca
	+NEW_VISITS, @ca
	+UPDATED_VISITS, @ca
	+VISIT_SELECTED, @ca
	-_filtered_visit_keys
	-_selected_visit
	-_visits
	cruises, @p
	months, @p
	selected_visit, @p
	stations, @p
	visit_keys, @p
	visits, @p
	years, @p
==
	+apply_filter()
	+first_visit_id_or_none()
	+first_visit_or_none()
	+possible_basins()
	+possible_cruises()
	+possible_files()
	+possible_months()
	+possible_stations()
	+possible_years()
	+set_visit()
	+set_visit_by_key()
	+set_visits()
	+update_visits()
	+visit_by_index()
}


